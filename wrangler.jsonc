{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-cloud",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
